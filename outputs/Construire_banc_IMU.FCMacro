 item('Palier_tangage_'+str(sign),housing,yaw,metal,'Logement conceptuel 2 × 6004 par axe, Ø20/42/12 ; ajustements à définir')
 ring('Roulement_tangage_'+str(sign),21,10,12,(0,sign*425-6,650),V(0,1,0),yaw,dark)
 # long trunnion bridges from ring OD to housing, signed orientation
