for i in range(24):
 a=2*math.pi*i/24;shape=shape.cut(Part.makeCylinder(2.5,8,V(130*math.cos(a),130*math.sin(a),149)))
item('Index_lacet_15deg',shape,yaw,metal,'Disque Ø290 × 6, 24 trous Ø5 sur Ø260 ; fixation moyeu à détailler')
box('Support_index_lacet',30,30,65,115,-15,80,base,metal)
