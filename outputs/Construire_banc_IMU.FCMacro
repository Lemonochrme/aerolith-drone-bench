  plate=plate.cut(slot)
item('Platine_adaptation_160x300',plate,roll,metal,'Aluminium 8 mm ; perçages Ø4,5 sur carrés 50 et 70 mm ; 4 lumières 6,5 × 30,5')
for x in (-25,25):
 for y in (-25,25):
  cylinder('Entretoise_M4',4,43,(x,y,-78),parent=roll,color=green)
  cylinder('Vis_M4_reference',2,58,(x,y,-90),parent=roll,color=dark)
# DXF exact outlines. The base drawing has tiny endpoint gaps; close using 0.01 mm sorting tolerance.
source=json.loads((OUT/'contours_source.json').read_text(encoding='utf-8'))
faces={}
for name,entities in source.items():
 edges=[]
 for e in entities:
  if e[0]=='LINE':edges.append(Part.makeLine(V(*e[1]),V(*e[2])))
  elif e[0]=='CIRCLE':edges.append(Part.makeCircle(e[2],V(*e[1])))
  elif e[0]=='ARC':edges.append(Part.makeCircle(e[2],V(*e[1]),V(0,0,1),e[3],e[4] if e[4]>e[3] else e[4]+360))
 for edge in edges:edge.fixTolerance(.001)
 faces[name]=Part.makeFace([Part.Wire(w) for w in Part.sortEdges(edges,.01)],'Part::FaceMakerBullseye')
basekey=next(k for k in faces if k.startswith('Base'))
o=item('LithFrame_base_DXF',faces[basekey].extrude(V(0,0,3)),ref,carbon,'Contours source DXF ; épaisseur 3 mm supposée ; orientation Y longitudinal');o.Placement.Base=V(0,0,-35)
# Source parts library: do not invent assembled arm locations from flat parts.
lib=D.addObject('App::Part','Bibliotheque_DXF');lib.Label='06 — Pièces DXF sources / masquées'
for name,f in faces.items():
 ob=item('Source_'+name.replace(' ','_'),f.extrude(V(0,0,3)),lib,carbon,'Géométrie DXF source, épaisseur supposée 3 mm');ob.Visibility=False
lib.Visibility=False
# Representative target volume, hidden by default.
env=D.addObject('Part::Cylinder','Enveloppe_drone_500');ref.addObject(env);env.Label='Enveloppe cible Ø500 × 160 / afficher pour contrôler';env.Radius=250;env.Height=160;env.Placement.Base=V(0,0,-80);style(env,green);env.ViewObject.Transparency=85;env.Visibility=False
# Axes visual markers (hidden in STEP and save view).
axes=D.addObject('App::Part','Reperes');axes.Label='07 — Repères axes / masqués'
for name,axis,c in [('X_roulis',V(1,0,0),(1.,0.2,0.2)),('Y_tangage',V(0,1,0),(0.2,0.8,0.3)),('Z_lacet',V(0,0,1),(0.2,0.4,1.))]:
 ob=cylinder(name,2,500,(0,0,650),axis,axes,c);ob.Visibility=False
axes.Visibility=False
D.recompute()
# Check native BRep bodies and exported mechanical objects.
visible=[o for o in solids if o.Visibility and o not in lib.Group and o not in axes.Group]
checks=[]
for o in visible:
 checks.append({'piece':o.Name,'valid':o.Shape.isValid(),'solids':len(o.Shape.Solids),'volume_mm3':o.Shape.Volume})
report={'document':D.Name,'parts':len(checks),'invalid':[r for r in checks if not r['valid'] or r['solids']==0], 'checks':checks, 'clearances_mm':{'enveloppe_drone_vers_anneau_roulis':286-math.sqrt(250**2+80**2),'sweep_anneau_roulis_vers_tangage':341-math.sqrt(310**2+8**2),'anneau_tangage_vers_fourche':405-math.sqrt(365**2+8**2),'anneau_tangage_vers_traverse':650-math.sqrt(365**2+8**2)-240},'source_dxf':{'units':'mm','base_dimensions':[126,270],'short_arm_length':160,'long_arm_length':190,'source_thickness_assumption':3,'endpoint_join_tolerance_mm':.01},'limitations':['Avant-projet manuel, pas de validation structurelle','Chapes, freins, indexeurs esquissés : tolérances et fixations à détailler','Pas de simulation dynamique ni calibration métrologique','Assemblage complet du drone non déductible des pièces à plat']}
(OUT/'verification_geometrie.json').write_text(json.dumps(report,indent=2,ensure_ascii=False),encoding='utf-8')
Gui.activeDocument().activeView().viewAxonometric();Gui.activeDocument().activeView().fitAll()
Gui.activeDocument().activeView().setAnimationEnabled(False) if hasattr(Gui.activeDocument().activeView(),'setAnimationEnabled') else None
D.recompute();D.saveAs(str(OUT/'Banc_IMU_F380_500.FCStd'))
# Part export retains individual solids and global placements.
import Import
exportdoc=App.newDocument('Export_STEP')
exportitems=[]
for obj in visible:
 tmp=exportdoc.addObject('PartDesign::Feature',obj.Name)
 tmp.Label=obj.Label
 tmp.Shape=obj.Shape.copy()
 tmp.Placement=obj.getGlobalPlacement()
 tmp.ViewObject.ShapeColor=obj.ViewObject.ShapeColor
 exportitems.append(tmp)
exportdoc.recompute()
Import.export(exportitems,str(OUT/'Banc_IMU_F380_500.step'))
App.closeDocument(exportdoc.Name)
App.setActiveDocument(D.Name)
Gui.activeDocument().activeView().saveImage(str(OUT/'Banc_IMU_vue_ensemble.png'),1800,1400,'White')
# Exploit live additive MCP bridge on localhost only.
try:
 import sys
 p=os.path.join(App.getUserAppDataDir(),'Mod','FreeCADMCP')
 if p not in sys.path:sys.path.insert(0,p)
 from rpc_server import rpc_server
 msg=rpc_server.start_rpc_server()
 (OUT/'etat_mcp.txt').write_text(msg+'\nAddon: '+p,encoding='utf-8')
except Exception:
 (OUT/'etat_mcp.txt').write_text(traceback.format_exc(),encoding='utf-8')
(OUT/'construction_terminee.txt').write_text('OK',encoding='utf-8')
