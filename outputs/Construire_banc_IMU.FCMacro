S.set('A1','PARAMÈTRE');S.set('B1','VALEUR mm / deg');S.setStyle('A1:B1','bold','add'); S.setBackground('A1:B1',(0.1,0.22,0.32)); S.setForeground('A1:B1',(1.,1.,1.))
for i,(label,value,alias) in enumerate(rows,2): S.set('A'+str(i),label);S.set('B'+str(i),str(value));S.setAlias('B'+str(i),alias)
