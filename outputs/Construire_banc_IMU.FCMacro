 item('Chape_tangage_'+str(sign),lug,pitch,blue,'Fixation mécanique de la chape par 4 vis M5 à détailler')
outer=ring('Anneau_tangage',365,341,16,(0,0,-8),V(0,0,1),pitch,blue,'Parametres.PitchRadius')
inner=ring('Anneau_roulis',310,286,16,(0,0,-8),V(0,0,1),roll,orange,'Parametres.RollRadius')
for sign in (-1,1):
 # Housing at X +/- 353, on pitch ring. Bore parallel to X.
 h=Part.makeBox(24,60,60,V(sign*353-12,-30,-30)).cut(Part.makeCylinder(21,26,V(sign*353-13,0,0),V(1,0,0)))
 item('Palier_roulis_'+str(sign),h,pitch,metal)
 ring('Roulement_roulis_'+str(sign),21,10,12,(sign*353-6,0,0),V(1,0,0),pitch,dark)
 cylinder('Tourillon_roulis_'+str(sign),10,110,(sign*300,0,0),V(sign,0,0),roll,metal)
 item('Chape_roulis_'+str(sign),Part.makeBox(28,44,28,V(sign*298-14,-22,-14)),roll,orange)
# Indexing concept: 24 positions / 15 degrees. Pin retracts before rotation.
def indexdisc(name,pos,axis,parent):
 shape=Part.makeCylinder(62,6,V(),V(0,0,1)).cut(Part.makeCylinder(10,6,V(),V(0,0,1)))
 for i in range(24):
  a=2*math.pi*i/24;shape=shape.cut(Part.makeCylinder(2.5,8,V(48*math.cos(a),48*math.sin(a),-1)))
 shape.Placement=App.Placement(V(*pos),App.Rotation(V(0,0,1),axis))
 return item(name,shape,parent,metal,'Disque Ø124 × 6 ; 24 trous Ø5 sur Ø96 ; indexage 15° ; moyeu fendu à détailler')
indexdisc('Index_tangage_15deg',(0,462,0),V(0,1,0),pitch)
box('Support_index_tangage',25,25,65,35,413,625,yaw,blue)
box('Bras_index_tangage',25,43,12,35,438,644,yaw,blue)
cylinder('Pion_tangage_retractable',2.4,25,(48,452,650),V(0,1,0),yaw,dark)
cylinder('Poignee_tangage',19,12,(0,480,0),V(0,1,0),pitch,dark)
indexdisc('Index_roulis_15deg',(385,0,0),V(1,0,0),roll)
box('Support_index_roulis',20,25,40,345,-12,25,pitch,blue)
