roll=D.addObject('App::Part','Roulis');pitch.addObject(roll);roll.Label='04 — Roulis X / anneau Ø620';roll.Placement=App.Placement(V(),App.Rotation(V(1,0,0),0));roll.setExpression('Placement.Rotation.Angle','Parametres.Roll * 1 deg')
ref=D.addObject('App::Part','DroneReference');roll.addObject(ref);ref.Label='05 — Référence LithFrame / assemblage indicatif'
metal=(0.68,0.73,0.78); blue=(0.12,0.40,0.62); orange=(0.96,0.48,0.12); dark=(0.15,0.18,0.22); carbon=(0.22,0.24,0.27); green=(0.15,0.67,0.55)
solids=[]; bom=[]
def style(o,c):
 o.ViewObject.ShapeColor=c;o.ViewObject.LineColor=(0.12,0.14,0.17);o.ViewObject.DisplayMode='Flat Lines';return o
def item(name,shape,parent,color,desc=''):
 o=D.addObject('PartDesign::Feature',name);o.Label=name.replace('_',' ');o.Shape=shape;parent.addObject(o);style(o,color)
 if desc:o.addProperty('App::PropertyString','Specification','Documentation');o.Specification=desc
 solids.append(o);return o
def box(name,l,w,h,x,y,z,parent=base,color=metal):
 o=D.addObject('Part::Box',name);o.Label=name.replace('_',' ');o.Length=l;o.Width=w;o.Height=h;o.Placement.Base=V(x,y,z);parent.addObject(o);style(o,color);solids.append(o);return o
def cylinder(name,r,h,pos,axis=V(0,0,1),parent=base,color=metal):
 o=D.addObject('Part::Cylinder',name);o.Label=name.replace('_',' ');o.Radius=r;o.Height=h;o.Placement=App.Placement(V(*pos),App.Rotation(V(0,0,1),axis));parent.addObject(o);style(o,color);solids.append(o);return o
def ring(name,ro,ri,t,pos,axis,parent,color,expr=None):
 a=cylinder(name+'_brut',ro,t,pos,axis,parent,color);b=cylinder(name+'_vide',ri,t,pos,axis,parent,color)
 o=D.addObject('Part::Cut',name);o.Base=a;o.Tool=b;parent.addObject(o);style(o,color);a.Visibility=False;b.Visibility=False;solids.remove(a);solids.remove(b);solids.append(o)
 if expr:
  a.setExpression('Radius',expr);b.setExpression('Radius',expr+' - Parametres.RingWidth');a.setExpression('Height','Parametres.RingThickness');b.setExpression('Height','Parametres.RingThickness')
 return o
# Frame of closed aluminium square tubes, 40 x 40 x 3.
def tube(name,l,w,h,x,y,z,parent=base,color=metal):
 axis=max(range(3),key=lambda k:[l,w,h][k]); dims=[l,w,h];inner=[l,w,h];p=[x,y,z]
 for k in range(3):
  if k!=axis:inner[k]-=6;p[k]+=3
 p[axis]-=1;inner[axis]+=2
 return item(name,Part.makeBox(*dims,V(x,y,z)).cut(Part.makeBox(*inner,V(*p))),parent,color,'Tube aluminium 40 × 40 × 3 mm — coupes à confirmer')
for y in (-500,460):tube('Longeron_'+str(y),1000,40,40,-500,y,30)
for x in (-500,460):tube('Traverse_'+str(x),40,920,40,x,-460,30)
for x in (-90,50):tube('Support_plateau_'+str(x),40,920,40,x,-460,30)
