 plate=Part.makeBox(3,200,80,V(sign*360 if sign==1 else -363,-100,-40))
 plate=plate.cut(Part.makeCylinder(19,5,V(sign*359 if sign==1 else -364,0,0),V(1,0,0)))
 for yy in [-85,-65,65,85]:plate=plate.cut(Part.makeCylinder(3.3,5,V(sign*359 if sign==1 else -364,yy,0),V(1,0,0)))
 add('AL_01_Plaque_pont_80x200x3',plate,pitch,metal,'Plat aluminium 80 × 200 × 3 ; trou central Ø38 ; 4 trous Ø6,6 sur axe à ±65 et ±85 ; liaison des 2 segments 3030','Plat aluminium')
def bearing_module(name,parent,pos,rr,typ,indexed=False):
 sh=body if typ=='pitch' else bodyroll
 add(name+'_Corps',place(sh,pos,rr),parent,blue,'Corps avec épaulement intégré ; chargement des roulements par la face ouverte ; entretoise 09 entre bagues extérieures','Impression')
 add(name+'_Capot',place(place(brake if indexed else cap,(0,0,40)),pos,rr),parent,blue,'03 couvercle indexage' if indexed else '02 couvercle simple','Impression')
 for z in [2.1,27.9]:add(name+'_6004',place(ring(21,10,12,z),pos,rr),parent,dark,'6004-2RS, 20 × 42 × 12 mm','Standard')
 add(name+'_Entretoise_09',place(place(spacer,(0,0,14.1)),pos,rr),parent,orange,'09 entretoise imprimée, entre les bagues extérieures seulement','Impression')
 for x in [-29,29]:
  for y in [-29,29]:
   pp=V(*pos)+rr.multVec(V(x,y,0));aa=rr.multVec(V(0,0,1));bolt(name+'_M4x55',2,55,tuple(pp),tuple(aa),parent)
 holes=[(-15,-55),(15,-55)] if typ=='pitch' else [(0,-85),(0,-65),(0,65),(0,85)]
 for x,y in holes:
  zz=32 if typ=='pitch' else 8;az=1 if typ=='pitch' else -1;length=16 if typ=='pitch' else 20
  pp=V(*pos)+rr.multVec(V(x,y,zz));aa=rr.multVec(V(0,0,az));bolt(name+'_M6',3,length,tuple(pp),tuple(aa),parent)
for sign in [-1,1]:
 rr=rotation((-sign,0,0),(0,0,1),(0,sign,0))
 bearing_module('Palier_tangage_'+str(sign),yaw,(0,sign*405,765),rr,'pitch',sign==1)
 hr=rotation((1,0,0),(0,0,-sign),(0,sign,0))
 add('Moyeu_tangage',place(hub,(0,sign*360,0),hr),pitch,orange,'04 moyeu ; deux M6x16 vers profilé, deux M5x60 / écrous hexagonaux','Impression')
 add('Axe_tangage_20x150',Part.makeCylinder(10,150,V(0,sign*368,0),V(0,sign,0)),pitch,metal,'Arbre lisse Ø20 h6, coupe droite 150 mm','Standard')
 for dist in [390.1,445.9]:add('Bague_arret_tangage',place(ring(16,10,14),(0,sign*dist,0),hr),pitch,dark,'Bague d’arrêt DIN 705 Ø20, Øextérieur 32 maxi, largeur 14 ; réglage sans précharge','Standard')
 for dist,thick in [(404.1,3),(444.9,1)]:add('Rondelles_tangage_20x28',place(ring(14,10,thick),(0,sign*dist,0),hr),pitch,metal,'Empilage de rondelles DIN 988 20 × 28 × 1 ; appui uniquement sur bague intérieure','Standard')
 if sign==1:add('Volant_tangage',place(wheel,(0,481,0),hr),pitch,orange,'06 volant / indexage 15° / 2 M5x60','Impression')
 for x in [-27,27]:bolt('Fixation_moyeu_M6x16',3,16,(x,sign*368,0),(0,-sign,0),pitch)
for sign in [-1,1]:
 rr=rotation((0,0,1),(0,-sign,0),(sign,0,0))
 bearing_module('Palier_roulis_'+str(sign),pitch,(sign*363,0,0),rr,'roll',sign==1)
 hr=rotation((0,1,0),(0,0,sign),(sign,0,0))
 add('Moyeu_roulis',place(hub,(sign*310,0,0),hr),roll,orange,'04 moyeu, 2 M6x16 et 2 M5x60','Impression')
 add('Axe_roulis_20x150',Part.makeCylinder(10,150,V(sign*318,0,0),V(sign,0,0)),roll,metal,'Arbre lisse Ø20 h6, coupe 150 mm','Standard')
 for dist in [348.1,403.9]:add('Bague_arret_roulis',place(ring(16,10,14),(sign*dist,0,0),hr),roll,dark,'Bague d’arrêt DIN 705 Ø20, Øextérieur 32 maxi, largeur 14','Standard')
 for dist,thick in [(362.1,3),(402.9,1)]:add('Rondelles_roulis_20x28',place(ring(14,10,thick),(sign*dist,0,0),hr),roll,metal,'DIN 988 20 × 28 × 1, empilage côté épaulement 3 mm, côté couvercle 1 mm','Standard')
 if sign==1:add('Volant_roulis',place(wheel,(430,0,0),hr),roll,orange,'06 volant / 24 positions à 15° / 2 M5x60','Impression')
 for y in [-27,27]:bolt('Fixation_moyeu_roulis_M6',3,16,(sign*318,y,0),(-sign,0,0),roll)
for ob in list(parts):
 pp=ob.Shape.Placement.Base
 if ob.Name.startswith('Palier_tangage_1_M4x55') and abs(pp.x+29)<.1:
  parts.remove(ob);D.removeObject(ob.Name);bolt('Index_tangage_M4x65',2,65,(-29,455,pp.z),(0,-1,0),yaw)
 elif ob.Name.startswith('Palier_roulis_1_M4x55') and abs(pp.z-29)<.1:
  parts.remove(ob);D.removeObject(ob.Name);bolt('Index_roulis_M4x65',2,65,(413,pp.y,29),(-1,0,0),pitch)
# Four printed drop saddles and two aluminium crossrails.
for sign in [-1,1]:
 rot=App.Rotation(V(0,0,1),0 if sign==1 else 180)
 for y in [-90,90]:
