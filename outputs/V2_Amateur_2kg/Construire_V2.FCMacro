S=D.addObject('Spreadsheet::Sheet','Parametres');S.Label='00 — Angles et données de référence'
for cell,value in {'A1':'PARAMÈTRE','B1':'VALEUR','A2':'Masse drone (kg)','B2':'2','A3':'Plateau imprimante (mm)','B3':'220','A4':'Lacet (degrés)','B4':'0','A5':'Tangage (degrés)','B5':'0','A6':'Roulis (degrés)','B6':'0','A7':'Hauteur axes (référence)','B7':'765','A8':'Cadre extérieur (référence)','B8':'720','A9':'Cadre intérieur (référence)','B9':'620','A10':'Enveloppe drone Ø × h','B10':'500 × 160 mm','A12':'ANGLES MODIFIABLES : B4, B5, B6','A13':'Dimensions : modifier la macro puis reconstruire','A14':'Usage manuel statique, sans hélices','A15':'2 kg = donnée de conception, pas charge certifiée'}.items():S.set(cell,value)
for cell,alias in [('B4','Yaw'),('B5','Pitch'),('B6','Roll')]:S.setAlias(cell,alias)
S.setColumnWidth('A',330);S.setColumnWidth('B',200);S.setStyle('A1:B1','bold','add')
base=D.addObject('App::Part','Socle');base.Label='01 — Socle 3030 / contreplaqué'
yaw=D.addObject('App::Part','Lacet');yaw.Label='02 — Lacet / fourche 3060'
yaw.Placement=App.Placement(V(),App.Rotation(V(0,0,1),0));yaw.setExpression('Placement.Rotation.Angle','Parametres.Yaw * 1 deg')
pitch=D.addObject('App::Part','Tangage');yaw.addObject(pitch);pitch.Label='03 — Cadre tangage 720 × 720';pitch.Placement=App.Placement(V(0,0,765),App.Rotation(V(0,1,0),0));pitch.setExpression('Placement.Rotation.Angle','Parametres.Pitch * 1 deg')
roll=D.addObject('App::Part','Roulis');pitch.addObject(roll);roll.Label='04 — Cadre roulis 620 × 620';roll.Placement=App.Placement(V(),App.Rotation(V(1,0,0),0));roll.setExpression('Placement.Rotation.Angle','Parametres.Roll * 1 deg')
ref=D.addObject('App::Part','DroneReference');roll.addObject(ref);ref.Label='05 — Platine LithFrame exacte / référence'
