  bolt('Drone_M4x45',2,45,(x,y,-20),(0,0,-1),roll)
# Exact supplied central plate, 3 mm assumed.
src=json.loads((O/'Sources'/'contours_source.json').read_text(encoding='utf-8'));es=next(v for k,v in src.items() if k.startswith('Base'))
edges=[]
for e in es:
 if e[0]=='LINE':edges.append(Part.makeLine(V(*e[1]),V(*e[2])))
 elif e[0]=='CIRCLE':edges.append(Part.makeCircle(e[2],V(*e[1])))
 elif e[0]=='ARC':edges.append(Part.makeCircle(e[2],V(*e[1]),V(0,0,1),e[3],e[4] if e[4]>e[3] else e[4]+360))
for e in edges:e.fixTolerance(.001)
face=Part.makeFace([Part.Wire(w) for w in Part.sortEdges(edges,.01)],'Part::FaceMakerBullseye')
add('LithFrame_base_DXF',place(face.extrude(V(0,0,3)),(0,0,-23)),ref,dark,'Contours source réels ; épaisseur 3 mm supposée ; masse 2 kg donnée pour drone complet','Référence')
# Two printed lock arms on the exterior brake caps; pin shown removed for free movement.
for name,parent,pos,rr in [
 ('Index_tangage',yaw,(0,445,765),rotation((-1,0,0),(0,0,1),(0,1,0))),
 ('Index_roulis',pitch,(403,0,0),rotation((0,0,1),(0,-1,0),(1,0,0)))]:
 add(name+'_Bras',place(arm,pos,rr),parent,blue,'07 bras indexage ; 2 M4x65 partagés avec le couvercle ; vis M5x35 + écrou papillon à insérer après alignement','Impression')
 pp=V(*pos)+rr.multVec(V(45,0,90));aa=rr.multVec(V(0,0,-1))
 add(name+'_Goupille_retiree',place(Part.makeCylinder(2.5,35).fuse(Part.makeCylinder(5,4,V(0,0,-4))),tuple(pp),App.Rotation(V(0,0,1),aa)),parent,dark,'Vis M5x35 utilisée comme goupille, représentée retirée. Retenir par écrou papillon lorsqu’elle est engagée.','Standard')
# Two additional clamp bolts per hub and per wheel. Nuts are ordinary M5 in printed hexagonal pockets.
for ob in list(parts):
 if ob.Name.startswith(('Moyeu_tangage','Moyeu_roulis','Volant_tangage','Volant_roulis')):
  pp=ob.Shape.Placement
  parent=next(q for q in [pitch,roll] if ob in q.Group)
  for z in [14,23]:
   a=pp.multVec(V(15,-25,z));b=pp.Rotation.multVec(V(0,1,0));bolt('Serrage_moyeu_M5x60',2.5,60,tuple(a),tuple(b),parent)
# Show M6 fasteners through plywood gussets, at slots on the side faces.
for sign in [-1,1]:
 for side in [-1,1]:
  for yy,zz in [(300,108),(460,158),(460,258)]:bolt('Gousset_M6x25',3,25,(side*48,sign*yy,zz),(-side,0,0),yaw)
for x in [-100,100]:
 for y in [-150,150]:bolt('Embase_M6x25',3,25,(x,y,63),(0,0,-1),base)
for x in [-15,15]:
 for y in [-170,170]:bolt('Traverse_sur_CP_M6x25',3,25,(x,y,75),(0,0,1),yaw)
# Four rail-fixing bolts below the drop brackets.
for sx in [-1,1]:
 for y in [-90,90]:bolt('Console_sous_rail_M6x16',3,16,(sx*260,y,-93),(0,0,1),roll)
# Envelope hidden; excluded explicitly from STEP.
env=add('Enveloppe_drone_500x160',Part.makeCylinder(250,160,V(0,0,-80)),ref,green,'Volume de contrôle, masqué','Contrôle');env.Visibility=False
D.recompute()
visible=[o for o in parts if o not in lib.Group and o is not env]
invalid=[o.Name for o in visible if not o.Shape.isValid() or len(o.Shape.Solids)!=1]
report={'pieces_visibles':len(visible),'invalides':invalid,'impressions':printed,'coupes':cuts,'masse_drone_kg':2,'charge_admissible_certifiee':False,'avertissement':'Les fixations standard sont schématiques ; confirmer épaisseur et perçages du roulement de lacet acheté.'}
(O/'verification_V2.json').write_text(json.dumps(report,indent=2,ensure_ascii=False),encoding='utf-8')
Gui.activeDocument().activeView().viewAxonometric();Gui.activeDocument().activeView().fitAll();Gui.activeDocument().activeView().getCameraNode().height.setValue(1600)
D.recompute();D.saveAs(str(O/'Banc_IMU_V2_Amateur_2kg.FCStd'))
ex=App.newDocument('Export_V2');items=[]
for o in visible:
 q=ex.addObject('PartDesign::Feature',o.Name);q.Label=o.Label;q.Shape=o.Shape.copy();q.Placement=o.getGlobalPlacement();q.ViewObject.ShapeColor=o.ViewObject.ShapeColor;items.append(q)
ex.recompute();Import.export(items,str(O/'Banc_IMU_V2_Amateur_2kg.step'));App.closeDocument(ex.Name);App.setActiveDocument(D.Name)
Gui.activeDocument().activeView().saveImage(str(O/'Banc_V2_vue_ensemble.png'),1800,1400,'White')
print('V2 créée',report['pieces_visibles'],'pièces, invalides',invalid)
