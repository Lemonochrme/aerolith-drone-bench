metal=(.72,.76,.8);wood=(.76,.58,.34);blue=(.12,.42,.64);orange=(.97,.48,.14);dark=(.18,.20,.22);green=(.15,.65,.45)
parts=[];cuts=[];printed=[]
def rotation(x,y,z):return App.Rotation(V(*x),V(*y),V(*z),'ZXY')
def place(shape,pos=(0,0,0),rot=None):
 sh=shape.copy();sh.Placement=App.Placement(V(*pos),rot or App.Rotation());return sh
def add(name,shape,parent,color=metal,spec='',kind=''):
 ob=D.addObject('PartDesign::Feature',name);ob.Label=name.replace('_',' ');ob.Shape=shape;parent.addObject(ob);ob.ViewObject.ShapeColor=color;ob.ViewObject.LineColor=(.16,.18,.2);ob.ViewObject.DisplayMode='Flat Lines'
 ob.addProperty('App::PropertyString','Specification','Fabrication');ob.Specification=spec
 ob.addProperty('App::PropertyString','Categorie','Fabrication');ob.Categorie=kind;parts.append(ob);return ob
profiles={}
for tag in ['3030','3060']:
 sh=Part.read(str(O/'Sources'/(tag+'.step')))
 face=max([f for f in sh.Faces if f.BoundBox.ZLength<.0001 and abs(f.CenterOfMass.z)<.001],key=lambda f:f.Area).copy()
 b=sh.BoundBox;face.translate(V(-(b.XMin+b.XMax)/2,-(b.YMin+b.YMax)/2,0));profiles[tag]=face
bracket=Part.read(str(O/'Sources'/'bracket.step'))
def beam(name,tag,length,pos,axis,parent):
 sh=profiles[tag].extrude(V(0,0,length));ob=add(name,place(sh,pos,App.Rotation(V(0,0,1),V(*axis))),parent,metal,f'Profilé {tag} Type B rainure 8 — coupe droite {length} mm','Profilé');cuts.append({'piece':name,'section':tag,'longueur_mm':length});return ob
def bracket_at(name,pos,parent,rot=None):return add(name,place(bracket,pos,rot),parent,metal,'Équerre Motedis S8BBR30 avec kit M6x12 / écrous B8','Standard')
def frame(name,size,z,parent):
 half=size/2;inner=half-30;mid=half-15
 for sign in [-1,1]:
  beam(name+'_X', '3030',size,(-half,sign*mid,z),(1,0,0),parent)
  if name=='Cadre_tangage':
   for yy in [-inner,50]:beam(name+'_Y_segment','3030',280,(sign*mid,yy,z),(0,1,0),parent)
  else:beam(name+'_Y','3030',size-60,(sign*mid,-inner,z),(0,1,0),parent)
 for sx,sy,angle in [(-1,-1,-90),(1,-1,0),(1,1,90),(-1,1,180)]:bracket_at(name+'_Equerre',(sx*inner,sy*inner,z),parent,App.Rotation(V(0,0,1),angle))
# Small standard fasteners, simplified unthreaded shanks and heads.
def bolt(name,r,length,pos,axis,parent,color=dark):
 sh=Part.makeCylinder(r,length).fuse(Part.makeCylinder(r*1.8,r,V(0,0,-r)))
 return add(name,place(sh,pos,App.Rotation(V(0,0,1),V(*axis))),parent,color,f'Vis M{int(2*r)} × {length} — représentation simplifiée','Visserie')
def ring(ro,ri,t,z=0):return Part.makeCylinder(ro,t,V(0,0,z)).cut(Part.makeCylinder(ri,t,V(0,0,z)))
def hexprism(af,length,pos,axis=V(0,0,1)):
 rr=af/math.sqrt(3);pts=[V(rr*math.cos(i*math.pi/3+math.pi/6),rr*math.sin(i*math.pi/3+math.pi/6),0) for i in range(6)];wire=Part.makePolygon(pts+[pts[0]]);sh=Part.Face(wire).extrude(V(0,0,length));sh.Placement=App.Placement(pos,App.Rotation(V(0,0,1),axis));return sh
# Universal printed bearing block: two 6004 bearings, 40 mm body, captive metal nuts on caps.
core=Part.makeBox(80,80,40,V(-40,-40,0)).cut(Part.makeCylinder(18,42,V(0,0,-1))).cut(Part.makeCylinder(21.1,39,V(0,0,2)))
body=core.fuse(Part.makeBox(80,50,8,V(-40,-90,32)))
bodyroll=core.fuse(Part.makeBox(80,60,8,V(-40,-100,0))).fuse(Part.makeBox(80,60,8,V(-40,40,0)))
for x in [-29,29]:
 for y in [-29,29]:
  hole=Part.makeCylinder(2.25,42,V(x,y,-1));body=body.cut(hole);bodyroll=bodyroll.cut(hole)
for x in [-15,15]:body=body.cut(Part.makeCylinder(3.3,10,V(x,-55,31)))
for y in [-85,-65,65,85]:bodyroll=bodyroll.cut(Part.makeCylinder(3.3,10,V(0,y,-1)))
body=body.removeSplitter();bodyroll=bodyroll.removeSplitter()
spacer=Part.makeCylinder(20.95,13.8).cut(Part.makeCylinder(18,13.8))
cap=Part.makeBox(80,80,4,V(-40,-40,0)).cut(Part.makeCylinder(18,6,V(0,0,-1)))
for x in [-29,29]:
 for y in [-29,29]:cap=cap.cut(Part.makeCylinder(2.25,6,V(x,y,-1)))
brake=cap.fuse(Part.makeBox(8,80,8,V(-40,-40,4))).fuse(Part.makeBox(52,8,8,V(-32,-40,4))).fuse(Part.makeBox(52,8,8,V(-32,32,4))).removeSplitter()
# Split shaft hub, flange on a standard slot face: two M6 attachment screws, two M5 clamp screws.
hub=Part.makeBox(80,60,8,V(-40,-30,0)).fuse(Part.makeBox(42,50,20,V(-21,-25,8)))
hub=hub.cut(Part.makeCylinder(10.1,30,V(0,0,-1))).cut(Part.makeBox(23,1.2,21,V(0,-.6,8)))
for x in [-27,27]:hub=hub.cut(Part.makeCylinder(3.3,10,V(x,0,-1)))
for z in [14,23]:hub=hub.cut(Part.makeCylinder(2.7,52,V(15,-26,z),V(0,1,0))).cut(hexprism(8.3,4.5,V(15,20.5,z),V(0,1,0)))
hub=hub.removeSplitter()
# Drop bracket, final print orientation lies on one side, not upright.
