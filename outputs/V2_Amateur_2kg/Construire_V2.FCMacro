for y in [-20,20]:drop=drop.cut(Part.makeCylinder(3.3,10,V(15,y,14)))
drop=drop.cut(Part.makeCylinder(3.3,10,V(-20,0,-94))).removeSplitter()
# Handwheel with 15 degree witness ticks; no promise of metrological indexing.
wheel=Part.makeCylinder(55,8).fuse(Part.makeBox(42,50,20,V(-21,-25,8))).cut(Part.makeCylinder(10.1,30,V(0,0,-1)))
wheel=wheel.cut(Part.makeBox(22,1.2,20,V(0,-.6,8)))
for z in [14,23]:wheel=wheel.cut(Part.makeCylinder(2.7,52,V(15,-26,z),V(0,1,0))).cut(hexprism(8.3,4.5,V(15,20.5,z),V(0,1,0)))
for i in range(24):
 a=math.radians(i*15);wheel=wheel.cut(Part.makeCylinder(2.7,10,V(45*math.cos(a),45*math.sin(a),-1)));tick=Part.makeBox(5,1.5,.8,V(49,-.75,8));tick.rotate(V(),V(0,0,1),i*15);wheel=wheel.fuse(tick)
wheel=wheel.removeSplitter()
