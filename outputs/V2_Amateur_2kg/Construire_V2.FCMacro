guide=Part.makeBox(80,200,4,V(-40,-100,0))
for y in [-85,-65,65,85]:guide=guide.cut(Part.makeCylinder(3.3,6,V(0,y,-1)))
guide=guide.cut(Part.makeCylinder(1.6,6,V(0,0,-1)))
printspec=[('01_Corps_palier_tangage_x2',body,2,App.Rotation(V(1,0,0),180)),('01B_Corps_palier_pont_x2',bodyroll,2,None),('09_Entretoise_bagues_exterieures_x4',spacer,4,None),('02_Couvercle_simple_x2',cap,2,None),('03_Couvercle_indexage_x2',brake,2,None),('04_Moyeu_fendu_x4',hub,4,None),('05_Console_porte_drone_x4',drop,4,App.Rotation(V(1,0,0),90)),('06_Volant_repere_x2',wheel,2,None),('00_Coupon_ajustement_x1',coupon,1,None),('07_Bras_indexage_x2',arm,2,None),('08_Gabarit_plaques_pont_x1',guide,1,None)]
for name,shape,qty,orient in printspec:
 ob=add(name,shape,lib,orange,'PETG — voir guide pour orientation, reprise des trous et serrage','Impression');ob.Visibility=False
 printshape=shape.copy()
 if orient:printshape.Placement=App.Placement(V(),orient)
 b=printshape.BoundBox;printshape.translate(V(-b.XMin,-b.YMin,-b.ZMin))
 mesh=MeshPart.meshFromShape(Shape=printshape,LinearDeflection=.12,AngularDeflection=.15,Relative=False);mesh.write(str(O/'STL'/(name+'.stl')))
 printed.append({'piece':name,'quantite':qty,'dimensions_impression_mm':[printshape.BoundBox.XLength,printshape.BoundBox.YLength,printshape.BoundBox.ZLength],'solide_valide':shape.isValid(),'nombre_solides':len(shape.Solids),'maillage_ferme':mesh.isSolid(),'volume_mm3':shape.Volume})
