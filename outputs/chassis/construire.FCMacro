  addpart('Vis_centrale_M4x40',Part.makeCylinder(2,40,V(x,y,-24)).fuse(Part.makeCylinder(3.5,4,V(x,y,-28))),joints,black,'M4x40, fermeture des platines')
  vertices=[V(x+4.042*math.cos(k*math.pi/3),y+4.042*math.sin(k*math.pi/3),4) for k in range(7)]
  addpart('Ecrou_central_M4',Part.Face(Part.makePolygon(vertices)).extrude(V(0,0,5)).cut(Part.makeCylinder(2.1,5,V(x,y,4))),joints,metal,'Ecrou frein M4, hauteur indicative 5, filetage non represente')
