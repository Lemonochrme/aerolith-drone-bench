addpart('FC_composants',Part.makeBox(12,12,2,V(-6,-6,-11.4)).fuse(Part.makeBox(12,6,5,V(-6,9,-11.4))),elec,black,'Implantation indicative, carte exacte non fournie','equipment')
for x in [-15.25,15.25]:
 for y in [-15.25,15.25]:
  addpart('Silentbloc_FC',Part.makeCylinder(3.1,7,V(x,y,-20)).cut(Part.makeCylinder(1.65,7,V(x,y,-20))),elec,(.75,.25,.15),'Support souple indicatif L7','equipment')
for i,(x,y) in enumerate([(-14,-60),(14,-60),(-14,60),(14,60)],1):
 addpart('Isolant_ESC_'+str(i),Part.makeBox(18,50,2,V(x-9,y-25,-20)),elec,(.25,.25,.25),'Adhesif isolant provisoire 2 mm','equipment')
 board=Part.makeBox(18,50,1.6,V(x-9,y-25,-18));addpart('ESC_'+str(i),board,elec,green,'Reference non choisie ; enveloppe 50x18x8 mm, hors cables','equipment')
 chips=[]
 for yy in [-16,-5,6,17]:chips.append(Part.makeBox(13,8,6.4,V(x-6.5,y+yy-4,-16.4)))
 addpart('ESC_'+str(i)+'_composants',Part.makeCompound(chips),elec,black,'Composants indicatifs','equipment')
# Four ESC ties use six slots, sharing the central slot in each row.
for x,y in [(-14,-60),(14,-60),(-14,60),(14,60)]:
 xl=-29 if x<0 else 0;xr=xl+29
 yy=(1 if y>0 else -1)*(68.5 if x<0 else 71.5)
 tie=Part.makeBox(29.8,2.5,.8,V(xl-.4,yy-1.25,-24.8)).fuse(Part.makeBox(29.8,2.5,.8,V(xl-.4,yy-1.25,-10)))
 for xx in [xl,xr]:tie=tie.fuse(Part.makeBox(.8,2.5,15.6,V(xx-.4,yy-1.25,-24.8)))
 addpart('Collier_ESC',tie.removeSplitter(),elec,(.83,.33,.12),'Collier nylon 2.5x100, trajet simplifie ; six passes dans les platines','equipment')
# Battery remains outside the two plates; no electrical specification inferred.
addpart('Batterie_provisoire',Part.makeBox(44,148,52,V(-22,-74,11)),elec,(.18,.32,.53),'Reference non choisie ; enveloppe 148x44x52 mm, aucune capacite ni tension imposee','equipment')
addpart('Pad_batterie',Part.makeBox(40,140,7,V(-20,-70,4)),elec,(.25,.25,.25),'Pad isolant indicatif 7 mm','equipment')
for x in [-15.25,15.25]:
 for y in [-15.25,15.25]:bolt('Fixation_FC_M3x20',V(x,y,-24),(0,0,1),20,12.6)
for y in [-45,45]:
 strap=Part.makeBox(52,20,1,V(-26,y-10,63)).fuse(Part.makeBox(52,20,1,V(-26,y-10,-1)))
 for x in [-26,25]:strap=strap.fuse(Part.makeBox(1,20,65,V(x,y-10,-1)))
 addpart('Sangle_batterie',strap.removeSplitter(),elec,(.77,.37,.1),'Sangle indicative largeur 20 mm, passant dans les lumieres de la platine','equipment')
# Nominal 9x5x3: 228.6 diameter, geometric pitch 127, three blades.
def propeller(hand):
 profiles=[]
 for x,w in [(8.5,5),(15,13),(28,22),(52,24),(80,20),(103,12),(114.3,.7)]:
  ell=Part.Wire([Part.Ellipse(V(),w/2,min(.85,w/3)).toShape()]);ell.rotate(V(),V(0,0,1),90);ell.rotate(V(),V(0,1,0),90)
  pitch=hand*math.degrees(math.atan(127/(2*math.pi*x)));ell.rotate(V(),V(1,0,0),pitch);ell.translate(V(x,0,0));profiles.append(ell)
 blade=Part.makeLoft(profiles,True,False);s=Part.makeCylinder(9,9,V(0,0,-4.5))
 for a in [0,120,240]:
  b=blade.copy();b.rotate(V(),V(0,0,1),a);s=s.fuse(b)
 return s.cut(Part.makeCylinder(2.6,14,V(0,0,-7))).removeSplitter()
props={hand:propeller(hand) for hand in [-1,1]}
for sx in [-1,1]:
 for sy in [-1,1]:
  q=('D' if sx>0 else 'G')+('_AV' if sy>0 else '_AR');cc=mp+mr.multVec(MOTOR_CENTER);x,y=sx*cc.x,sy*cc.y
  # Simplified 3115 envelope. GTSkytenRC manufacturer drawing not available.
  shell=Part.makeCylinder(19,27,V(x,y,5)).cut(Part.makeCylinder(16.8,27,V(x,y,5)))
  cap=Part.makeCylinder(19,3,V(x,y,32))
  for a in range(0,360,60):
   vv=rot(V(11,0),a);cap=cap.cut(Part.makeCylinder(3.5,5,V(x+vv.x,y+vv.y,31)))
  addpart('GTSkytenRC_3115_640KV_'+q,shell.fuse(cap),propulsion,(.22,.23,.25),'Modele simplifie ; diametre 38 / corps 33 / arbre M5, dimensions GTSkytenRC non confirmees','equipment')
  base=Part.makeCylinder(17,3,V(x,y,2))
  for hx in [-MOTOR_HALF_SIDE,MOTOR_HALF_SIDE]:
   for hy in [-MOTOR_HALF_SIDE,MOTOR_HALF_SIDE]:
    vv=mr.multVec(V(hx,hy));base=base.cut(Part.makeCylinder(1.65,5,V(x+sx*vv.x,y+sy*vv.y,1)))
  addpart('Embase_moteur_'+q,base,propulsion,metal,'4 trous M3 : diagonales 19 mm, cote 19/sqrt(2) mm','equipment')
  for hx in [-MOTOR_HALF_SIDE,MOTOR_HALF_SIDE]:
   for hy in [-MOTOR_HALF_SIDE,MOTOR_HALF_SIDE]:
    vv=mr.multVec(V(hx,hy));bx,by=x+sx*vv.x,y+sy*vv.y
    addpart('Fixation_moteur_M3x8',Part.makeCylinder(1.5,8,V(bx,by,-2)).fuse(Part.makeCylinder(2.75,3,V(bx,by,-5))),joints,black,'M3x8 provisoire ; profondeur de vissage moteur a confirmer')
  addpart('Stator_3115_'+q,Part.makeCylinder(15.5,15,V(x,y,8)),propulsion,(.61,.32,.12),'Stator nominal 31x15','equipment')
  addpart('Arbre_M5_'+q,Part.makeCylinder(2.5,49,V(x,y,2)),propulsion,metal,'Arbre M5 simplifie, longueur indicative','equipment')
  pp=props[1 if sx*sy>0 else -1].copy();pp.translate(V(x,y,43.5))
  addpart('Helice_9x5x3_'+q,pp,propulsion,(.47,.49,.52),'Tripale diametre 228.6, pas geometrique 127 ; profil et moyeu indicatifs, pas un modele constructeur','equipment')

D.recompute()
# Detect unintended carbon/ carbon overlap in the assembled chassis.
for i,(n,s) in enumerate(shapes):
 for m,t in shapes[i+1:]:
  if s.BoundBox.intersect(t.BoundBox):
   vol=s.common(t).Volume
   if vol>.001:report['collisions_carbone_mm3'].append([n,m,round(vol,6)])
assert not report['collisions_carbone_mm3'],report['collisions_carbone_mm3']
feet=[s for n,s in shapes if n.startswith('Bras_Court_')]
assert len(feet)==4 and all(abs(s.BoundBox.ZMin+55)<1e-6 for s in feet)
others=[s for n,s in shapes if not n.startswith('Bras_Court_')]+[o.Shape for o in hardware+equipment]
ground_clearance=min(s.BoundBox.ZMin for s in others)+55
assert ground_clearance>20
report['pieds']={'quantite':4,'plan_appui_z_mm':-55,'garde_sous_platine_basse_mm':35-T,
                 'garde_sous_autres_pieces_mm':round(ground_clearance,3)}
report['volume_carbone_chassis_mm3']=round(sum(forms[n].Area*T*q for n,q in qty.items() if 'Coupon' not in n),3)
report['volume_origine_meme_epaisseur_mm3']=round(sum(d['aire_originale_mm2']*T*d['quantite'] for d in report['formes'].values() if d['aire_originale_mm2'] is not None),3)
# Clearances apply to the modeled envelopes, not to unspecified real equipment.
report['interferences_carbone_equipements']=[]
for n,shape in shapes:
 for obj in hardware+equipment:
  other=obj.Shape
  if shape.BoundBox.intersect(other.BoundBox):
   volume=shape.common(other).Volume
   if volume>.01:report['interferences_carbone_equipements'].append([n,obj.Name,round(volume,4)])
assert not report['interferences_carbone_equipements'],report['interferences_carbone_equipements']
report['interferences_fixations']=[]
for i,obj in enumerate(hardware):
 for other in hardware[i+1:]+equipment:
  if obj.Shape.BoundBox.intersect(other.Shape.BoundBox):
   volume=obj.Shape.common(other.Shape).Volume
   if volume>.01:report['interferences_fixations'].append([obj.Name,other.Name,round(volume,4)])
assert not report['interferences_fixations'],report['interferences_fixations']
report['interferences_colliers_ESC']=[]
for tie in [o for o in equipment if o.Name.startswith('Collier_ESC')]:
 for obj in equipment:
  if obj is tie:continue
  if tie.Shape.BoundBox.intersect(obj.Shape.BoundBox):
   volume=tie.Shape.common(obj.Shape).Volume
   if volume>.01:report['interferences_colliers_ESC'].append([tie.Name,obj.Name,round(volume,4)])
assert not report['interferences_colliers_ESC'],report['interferences_colliers_ESC']
cc=mp+mr.multVec(MOTOR_CENTER);centers=[(sx*cc.x,sy*cc.y) for sx in [-1,1] for sy in [-1,1]]
report['ecart_disques_helices_mm']=round(min(math.dist(a,b) for i,a in enumerate(centers) for b in centers[i+1:])-228.6,3)
report['interferences_disques_electronique']=[]
for i,(x,y) in enumerate(centers):
 sweep=Part.makeCylinder(114.3,26,V(x,y,30))
 for obj in equipment:
  if obj in elec.Group:
   volume=sweep.common(obj.Shape).Volume
   if volume>.01:report['interferences_disques_electronique'].append([i,obj.Name,round(volume,4)])
assert report['ecart_disques_helices_mm']>0 and not report['interferences_disques_electronique']
report['bras_pleins']=True;report['corniere_quantite']=0
(OUT/'.build/contours.json').write_text(json.dumps(contours,indent=2),encoding='utf-8');(OUT/'.build/verification.json').write_text(json.dumps(report,indent=2,ensure_ascii=False),encoding='utf-8')
# Separate planar layout at true scale (not a production nesting).
layout=D.addObject('App::Part','Vue_decoupe');layout.Label='03 / Pièces à plat, une de chaque / hors assemblage'
for key,xy in zip(forms,[(0,0),(180,90),(180,20),(160,-70),(160,-130)]):
 o=D.addObject('App::Link','Aplat_'+key);layout.addObject(o);o.setLink(masters[key]);o.LinkPlacement=App.Placement(V(xy[0],xy[1],0),App.Rotation());o.Visibility=True
layout.Visibility=False
lib.Visibility=False
D.recompute();D.saveAs(str(OUT/'chassis.FCStd'))
# Export assembly from globally positioned solids, independent from link visibility.
E=App.newDocument('Export_Chassis_CNC');ex=[]
for name,s in shapes:
 o=E.addObject('PartDesign::Feature',name);o.Shape=s;ex.append(o)
for spacer in hardware+equipment:
 o=E.addObject('PartDesign::Feature',spacer.Name);o.Shape=spacer.Shape;ex.append(o)
Import.export(ex,str(OUT/'chassis.step'));App.closeDocument(E.Name);App.setActiveDocument(D.Name)
if App.GuiUp:
 import FreeCADGui as Gui
 from pivy import coin
 v=Gui.activeDocument().activeView();v.viewAxonometric();v.fitAll();v.getCameraNode().height.setValue(510);D.save()
