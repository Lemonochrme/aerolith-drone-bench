for name,s in shapes:
 o=E.addObject('PartDesign::Feature',name);o.Shape=s;ex.append(o)
for spacer in fast.Group:
 o=E.addObject('PartDesign::Feature',spacer.Name);o.Shape=spacer.Shape;ex.append(o)
Import.export(ex,str(OUT/'STEP/Aerolith_Chassis_CNC_R1_assemble.step'));App.closeDocument(E.Name);App.setActiveDocument(D.Name)
if App.GuiUp:
 import FreeCADGui as Gui
 v=Gui.activeDocument().activeView();v.viewAxonometric();v.fitAll();Gui.updateGui();v.saveImage(str(OUT/'Chassis_CNC_R1_assemble.png'),1920,1200,'White')
